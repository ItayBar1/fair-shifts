DATABASE_URL=postgresql://fair_shifts:replace-me@db:5432/fair_shifts
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
OTP_SECRET=
MAIL_ENCRYPTION_KEY=
MAIL_TRANSPORT=disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Duties in the soldier's Google calendar (decision 205): true only once the client above carries calendar.app.created.
GOOGLE_CALENDAR_SYNC=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
MAIL_QUOTA_TIME_ZONE=UTC
# Enable only for staging/production with no direct route around the Tunnel.
TRUST_CLOUDFLARE_IP=false
# Backups: drive, directory (local tests only) or empty to switch them off.
BACKUP_STORAGE=
BACKUP_TIME=03:30
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Empty: the application creates its own folder (drive.file scope).
GOOGLE_DRIVE_FOLDER_ID=
# age public key (age1...). The private key is kept offline, never on the server.
AGE_RECIPIENT=
BACKUP_DIRECTORY=./.local/backups
BACKUP_DIRECTORY_QUOTA_BYTES=
RESTORE_MODE=false
# The independent deletion log (decision 196): a file outside the database and its backups.
# The production Compose file sets it to a volume of its own.
DELETION_LOG_DIRECTORY=./.local/deletion-log
