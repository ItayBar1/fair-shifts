FROM golang:1.26.9-alpine3.24@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0 AS builder
# Rebuild the exact 2026.10.0 source with Go's patched standard library (#161).
# The upstream binary still uses Go 1.26.8. Pin both source identity and content.
ADD --checksum=sha256:303c531b416b986bfcc2157c0a90556c94c519ec4d71e64d32abbe5c451f59ec https://codeload.github.com/cloudflare/cloudflared/tar.gz/18cdfe0a6fc7b72a0702d255a1f984e776ce0498 /tmp/source.tar.gz
WORKDIR /source
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 && rm /tmp/source.tar.gz
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN go mod download && go mod verify
# The release pins golang.org/x/net v0.58.0, which carries the HTTP/2 flaws of
# GO-2026-6603/6610/6611/6612/6617 (#167). Raise only that module to the fixed
# release; Go's proxy and checksum database vouch for it, and the build stays
# read-only against the result.
RUN go get golang.org/x/net@v0.60.0 && go mod verify
# Match upstream's container build flags; the source release time is deterministic.
RUN go build -mod=readonly -trimpath \
    -ldflags='-X main.Version=2026.10.0 -X main.BuildTime=2026-10-05T17:43:45Z -X github.com/cloudflare/cloudflared/metrics.Runtime=virtual' \
    -o /cloudflared ./cmd/cloudflared

# Keep the unprivileged runtime and CA trust, without compiler or source files.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates \
    && addgroup -g 65532 cloudflared && adduser -D -u 65532 -G cloudflared cloudflared
COPY --from=builder /cloudflared /usr/local/bin/cloudflared
USER 65532:65532
ENTRYPOINT ["cloudflared", "--no-autoupdate"]
CMD ["version"]
