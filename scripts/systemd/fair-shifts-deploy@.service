# Automatic deployment of main (scripts/auto-deploy.sh, docs/operations.md).
# The instance name is the operating user, who is in the docker group:
#   fair-shifts-deploy@<user>.service, started by the timer of the same name.
[Unit]
Description=Fair Shifts: deploy main after its checks passed (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=/opt/fair-shifts/app
Environment=FAIR_SHIFTS_CONFIG_DIR=/opt/fair-shifts/config
Environment=FAIR_SHIFTS_STATE_DIR=/opt/fair-shifts/deploy-state
ExecStart=/bin/sh /opt/fair-shifts/app/scripts/auto-deploy.sh
# A build and its migrations are never cut short by a timeout.
TimeoutStartSec=infinity
